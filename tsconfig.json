{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/main.tsx", "src/components/*.tsx", "src/components/icons/**/*.tsx", "src/lib/**/*.ts", "src/hooks/**/*.ts", "src/hooks/**/*.tsx", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
